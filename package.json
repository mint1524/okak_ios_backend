{
  "name": "okak-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OKAK AI Mobile backend (Fastify 5 + PostgreSQL 16)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "start:admin": "node --enable-source-maps dist/admin/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:admin": "tsx watch src/admin/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:reset": "tsx src/db/migrate.ts --reset",
    "seed": "tsx src/db/seed.ts",
    "test": "node --experimental-vm-modules --import tsx --test src/**/*.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# Application
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=replace_me_with_strong_random_value
JWT_REFRESH_SECRET=replace_me_with_another_strong_random_value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Admin basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_local_env

# Database
DATABASE_URL=postgres://okak:okak@127.0.0.1:5432/okak
PGSSLMODE=disable

# LLM (OpenAI-compatible)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=okak-standard
LLM_REQUEST_TIMEOUT_MS=60000

# Quotas
FREE_QUOTA_LIMIT=20

# Dev helpers
DEV_EMAIL_LOG=true
